{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "name": "${mod_displayName}",
  "version": "${mod_version}",
  "environment": "*",
  "description": "${mod_description}",
  "license": "All-Rights-Reserved",
  "authors": [
    "Example Author"
  ],
  "mixins": [
    "${mod_name}.mixins.json"
  ],
  "depends": {
    "quantum": ">=${versions_quantum}"
  },
  "entrypoints": {
    "main": [
      {
        "adapter": "scala",
        "value": "com.example.quantmod.ExampleMod"
      }
    ],
    "client": [
      {
        "adapter": "scala",
        "value": "com.example.quantmod.client.ExampleModClient"
      }
    ]
  }
}
